# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
venv/
.venv/
env/
ENV/

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# LaTeX build artifacts
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.toc
paper/*.synctex.gz
paper/*.fdb_latexmk
paper/*.fls
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.synctex.gz

# macOS specific files
.DS_Store
.AppleDouble
.LSOverride
._*

# IDE configuration
.idea/
.vscode/
*.swp
*.swo

# Large raw datasets (exclude CSV/zip, keep README.md)
data/*.csv
data/*.zip
data/*.tar.gz
!data/README.md

# Keep result directory structure
!.gitkeep
